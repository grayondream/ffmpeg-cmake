# =============================================================================
# Read the metadata tables out of the upstream ./configure script.
#
# We do not run configure; we only read its declarative lists (HAVE_LIST,
# CONFIG_LIST, CONFIG_EXTRA, ARCH_LIST, ALL_COMPONENTS) so that every macro
# the C sources rely on exists in the generated config.h, including the ones
# that are simply "0".
# =============================================================================

function(ffmpeg_parse_configure_lists)
    set(_file "${FFMPEG_SOURCE_DIR}/configure")
    file(READ "${_file}" _content)
    string(REPLACE "\r\n" "\n" _content "${_content}")
    string(REPLACE "\\\n" " " _content "${_content}")
    string(REPLACE "\n" ";" _lines "${_content}")

    set(_in_block "")
    set(_raw "")
    foreach(_line IN LISTS _lines)
        string(STRIP "${_line}" _sline)
        if(NOT _in_block STREQUAL "")
            if(_sline MATCHES "^\"$")
                set_property(GLOBAL PROPERTY "FFMPEG_SH_${_in_block}" "${_raw}")
                set(_in_block "")
                set(_raw "")
            else()
                string(APPEND _raw " ${_line}")
            endif()
        else()
            if(_line MATCHES "^([A-Z][A-Z0-9_]*)=\"(.*)$")
                set(_var "${CMAKE_MATCH_1}")
                set(_rest "${CMAKE_MATCH_2}")
                if(_rest MATCHES "\"$")
                    string(REGEX REPLACE "\"$" "" _rest "${_rest}")
                    set_property(GLOBAL PROPERTY "FFMPEG_SH_${_var}" "${_rest}")
                else()
                    set(_in_block "${_var}")
                    set(_raw "${_rest}")
                endif()
            endif()
        endif()
    endforeach()
endfunction()

# Expand one level of shell-style references inside <text>.
# Supported:  $VAR  ${VAR}  $(add_suffix <suffix> $LIST)
# Other $(...) constructs are dropped.
function(ffmpeg_expand_refs_once text out_changed out)
    set(_s "${text}")
    set(_out "")
    set(_changed FALSE)

    while(TRUE)
        string(FIND "${_s}" "$" _p)
        if(_p EQUAL -1)
            string(APPEND _out "${_s}")
            break()
        endif()

        string(SUBSTRING "${_s}" 0 ${_p} _pre)
        string(APPEND _out "${_pre}")
        if(_p GREATER 0)
            math(EXPR _pre_end "${_p}-1")
            string(SUBSTRING "${_s}" ${_pre_end} 1 _prev_char)
        else()
            set(_prev_char "")
        endif()

        math(EXPR _after "${_p}+1")
        string(SUBSTRING "${_s}" ${_after} -1 _srest)
        string(SUBSTRING "${_srest}" 0 1 _next_char)

        if(_next_char STREQUAL "{")
            string(FIND "${_srest}" "}" _close)
            if(_close EQUAL -1)
                string(APPEND _out "$")
                set(_s "${_srest}")
                continue()
            endif()
            math(EXPR _namelen "${_close}-1")
            string(SUBSTRING "${_srest}" 1 ${_namelen} _name)
            get_property(_sub GLOBAL PROPERTY "FFMPEG_SH_${_name}")
            string(APPEND _out "${_sub}")
            math(EXPR _skip "${_close}+1")
            string(SUBSTRING "${_srest}" ${_skip} -1 _s)
            set(_changed TRUE)

        elseif(_next_char STREQUAL "(")
            # $(add_suffix SUF $LIST) or an unsupported function: drop it.
            string(FIND "${_srest}" ")" _close)
            if(_close EQUAL -1)
                string(APPEND _out "$")
                set(_s "${_srest}")
                continue()
            endif()
            math(EXPR _inner_len "${_close}-1")
            string(SUBSTRING "${_srest}" 1 ${_inner_len} _inner)
            math(EXPR _skip "${_close}+1")
            string(SUBSTRING "${_srest}" ${_skip} -1 _s)

            if(_inner MATCHES "^add_suffix +([A-Za-z0-9_]+) +[$]([A-Za-z0-9_]+)$")
                set(_suffix "${CMAKE_MATCH_1}")
                set(_listvar "${CMAKE_MATCH_2}")
                set(_sdepth "")
                get_property(_sdepth GLOBAL PROPERTY FFMPEG_SH_DEPTH)
                string(LENGTH "${_sdepth}" _sdlen)
                if(_sdlen EQUAL 0)
                    set(_sdepth 0)
                endif()
                if(_sdepth LESS 32)
                    math(EXPR _sdepth "${_sdepth}+1")
                    set_property(GLOBAL PROPERTY FFMPEG_SH_DEPTH "${_sdepth}")
                    ffmpeg_sh_expand("${_listvar}" _list)
                    math(EXPR _sdepth "${_sdepth}-1")
                    set_property(GLOBAL PROPERTY FFMPEG_SH_DEPTH "${_sdepth}")
                else()
                    set(_list "")
                endif()
                set(_joined "")
                foreach(_item IN LISTS _list)
                    if(_item MATCHES "^[A-Za-z0-9_]+$")
                        list(APPEND _joined "${_item}${_suffix}")
                    endif()
                endforeach()
                string(REPLACE ";" " " _joined "${_joined}")
                string(APPEND _out "${_joined}")
                set(_changed TRUE)
            else()
                # Unsupported shell function: drop it.
                set(_changed TRUE)
            endif()

        elseif(_next_char MATCHES "^[A-Za-z_]$")
            # Scan a variable name.
            set(_idx 0)
            set(_slen 0)
            string(LENGTH "${_srest}" _slen)
            while(_idx LESS _slen)
                string(SUBSTRING "${_srest}" ${_idx} 1 _c)
                if(_c MATCHES "^[A-Za-z0-9_]$")
                    math(EXPR _idx "${_idx}+1")
                else()
                    break()
                endif()
            endwhile()
            string(SUBSTRING "${_srest}" 0 ${_idx} _name)
            get_property(_sub GLOBAL PROPERTY "FFMPEG_SH_${_name}")
            string(APPEND _out "${_sub}")
            string(SUBSTRING "${_srest}" ${_idx} -1 _s)
            set(_changed TRUE)

        else()
            string(APPEND _out "$")
            set(_s "${_srest}")
        endif()
    endwhile()

    set(${out_changed} ${_changed} PARENT_SCOPE)
    set(${out} "${_out}" PARENT_SCOPE)
endfunction()

function(ffmpeg_sh_expand var out)
    set(_text "")
    get_property(_text GLOBAL PROPERTY "FFMPEG_SH_${var}")
    string(LENGTH "${_text}" _tlen)
    if(_tlen EQUAL 0)
        set(${out} "" PARENT_SCOPE)
        return()
    endif()

    set(_depth 0)
    while(_depth LESS 32)
        math(EXPR _depth "${_depth}+1")
        ffmpeg_expand_refs_once("${_text}" _changed _text)
        if(NOT _changed)
            break()
        endif()
    endwhile()

    string(REGEX REPLACE "[ \t\r\n]+" ";" _tokens "${_text}")
    set(_names "")
    foreach(_t IN LISTS _tokens)
        if(_t MATCHES "^[A-Za-z0-9_]+$")
            list(APPEND _names "${_t}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _names)
    set(${out} "${_names}" PARENT_SCOPE)
endfunction()

function(ffmpeg_collect_metadata)
    ffmpeg_parse_configure_lists()

    ffmpeg_sh_expand(HAVE_LIST _have)
    set_property(GLOBAL PROPERTY FFMPEG_ALL_HAVE_NAMES "${_have}")

    # Every HAVE_* feature is decided before dependency resolution, exactly
    # like configure does.  Undetected ones are "no"; detection runs later
    # and overrides the state.
    foreach(_n IN LISTS _have)
        set(_cur "")
        get_property(_cur GLOBAL PROPERTY "FFMPEG_STATE_${_n}")
        string(LENGTH "${_cur}" _cur_len)
        if(_cur_len EQUAL 0)
            ffmpeg_state_set("${_n}" no)
        endif()
        ffmpeg_add_have_name("${_n}")
    endforeach()

    ffmpeg_sh_expand(ARCH_LIST _arch)
    list(LENGTH _arch _alen)
    if(_alen GREATER 0)
        set(FFMPEG_ARCH_LIST "${_arch}" PARENT_SCOPE)
    endif()

    ffmpeg_sh_expand(CONFIG_LIST _config)
    ffmpeg_sh_expand(CONFIG_EXTRA _extra)
    list(APPEND _config ${_extra})
    list(REMOVE_DUPLICATES _config)
    set_property(GLOBAL PROPERTY FFMPEG_ALL_CONFIG_NAMES "${_config}")

    foreach(_n IN LISTS _config)
        ffmpeg_add_resolve_name("${_n}")
        ffmpeg_add_config_name("${_n}")
    endforeach()

    # Optional external libraries are decided before dependency resolution:
    # unavailable ones must be "no", never "unset", so that a *_suggest entry
    # cannot accidentally switch them on.
    foreach(_lst EXTERNAL_LIBRARY_LIST EXTERNAL_LIBRARY_GPL_LIST
                EXTERNAL_LIBRARY_NONFREE_LIST EXTERNAL_LIBRARY_VERSION3_LIST
                EXTERNAL_LIBRARY_GPLV3_LIST EXTERNAL_AUTODETECT_LIBRARY_LIST
                HWACCEL_LIBRARY_LIST HWACCEL_AUTODETECT_LIBRARY_LIST)
        ffmpeg_sh_expand("${_lst}" _extnames)
        foreach(_n IN LISTS _extnames)
            ffmpeg_add_resolve_name("${_n}")
            ffmpeg_add_config_name("${_n}")
            set(_cur "")
            get_property(_cur GLOBAL PROPERTY "FFMPEG_STATE_${_n}")
            string(LENGTH "${_cur}" _cur_len)
            if(_cur_len EQUAL 0)
                ffmpeg_state_set("${_n}" no)
            endif()
        endforeach()
    endforeach()

    # Explicit defaults written in configure as "enable foo bar" / "disable foo".
    file(STRINGS "${FFMPEG_SOURCE_DIR}/configure" _dl_lines
         REGEX "^(enable|disable) [a-z0-9_ ]+$")
    foreach(_line IN LISTS _dl_lines)
        if(_line MATCHES "^(enable|disable) +(.*)$")
            set(_val yes)
            if(CMAKE_MATCH_1 STREQUAL "disable")
                set(_val no)
            endif()
            separate_arguments(_names UNIX_COMMAND "${CMAKE_MATCH_2}")
            foreach(_n IN LISTS _names)
                ffmpeg_add_resolve_name("${_n}")
                set(_cur "")
                get_property(_cur GLOBAL PROPERTY "FFMPEG_STATE_${_n}")
                string(LENGTH "${_cur}" _cur_len)
                if(_cur_len EQUAL 0)
                    ffmpeg_state_set("${_n}" "${_val}")
                endif()
            endforeach()
        endif()
    endforeach()

    list(LENGTH _have _hn)
    list(LENGTH _config _cn)
    ffmpeg_status("configure metadata: ${_hn} HAVE entries, ${_cn} CONFIG entries")
endfunction()
