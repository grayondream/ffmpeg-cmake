# =============================================================================
# CMake option surface, deliberately mirroring ./configure naming.
# =============================================================================

function(ffmpeg_option_name name out)
    string(TOUPPER "${name}" _u)
    set(${out} "FFMPEG_ENABLE_${_u}" PARENT_SCOPE)
endfunction()

function(ffmpeg_declare_tristate var doc)
    if(NOT DEFINED CACHE{${var}})
        set(${var} "AUTO" CACHE STRING "${doc}")
        set_property(CACHE ${var} PROPERTY STRINGS AUTO ON OFF)
    endif()
endfunction()

function(ffmpeg_declare_options)
    # Component switches: -DFFMPEG_ENABLE_H264_DECODER=ON/OFF/AUTO
    get_property(_components GLOBAL PROPERTY FFMPEG_ALL_COMPONENTS)
    foreach(_name IN LISTS _components)
        ffmpeg_option_name("${_name}" _opt)
        ffmpeg_declare_tristate("${_opt}" "Enable FFmpeg component '${_name}'")
        if(${_opt} STREQUAL "ON")
            ffmpeg_base_set("${_name}" yes)
        elseif(${_opt} STREQUAL "OFF")
            ffmpeg_base_set("${_name}" no)
        else()
            ffmpeg_base_set("${_name}" auto)
        endif()
    endforeach()

    # Library switches (--disable-avcodec, ...)
    foreach(_lib IN LISTS FFMPEG_LIBRARY_LIST)
        ffmpeg_option_name("${_lib}" _opt)
        ffmpeg_declare_tristate("${_opt}" "Build lib${_lib}")
        if(${_opt} STREQUAL "OFF")
            ffmpeg_base_set("${_lib}" no)
        else()
            ffmpeg_base_set("${_lib}" yes)
        endif()
    endforeach()

    # Program switches
    foreach(_prog IN LISTS FFMPEG_PROGRAM_LIST)
        ffmpeg_option_name("${_prog}" _opt)
        ffmpeg_declare_tristate("${_opt}" "Build the ${_prog} program")
        if(NOT FFMPEG_ENABLE_PROGRAMS)
            ffmpeg_base_set("${_prog}" no)
        elseif(${_opt} STREQUAL "OFF")
            ffmpeg_base_set("${_prog}" no)
        else()
            ffmpeg_base_set("${_prog}" yes)
        endif()
    endforeach()

    # Optional external libraries (--enable-libx264, ...)
    foreach(_spec IN LISTS FFMPEG_EXTERNAL_PKGS)
        string(REPLACE "|" ";" _parts "${_spec}")
        list(GET _parts 0 _name)
        ffmpeg_option_name("${_name}" _opt)
        ffmpeg_declare_tristate("${_opt}" "Enable external library '${_name}'")
        ffmpeg_base_set("${_name}" auto)
    endforeach()

    ffmpeg_apply_configure_flags()
endfunction()

# Map a subset of ./configure style flags onto the CMake state.
function(ffmpeg_apply_configure_flags)
    if(FFMPEG_CONFIGURE_FLAGS STREQUAL "")
        return()
    endif()

    string(REPLACE ";" " " _flags "${FFMPEG_CONFIGURE_FLAGS}")
    separate_arguments(_flags UNIX_COMMAND "${_flags}")

    foreach(_flag IN LISTS _flags)
        if(_flag MATCHES "^--enable-(.+)$")
            set(_value yes)
            set(_name "${CMAKE_MATCH_1}")
        elseif(_flag MATCHES "^--disable-(.+)$")
            set(_value no)
            set(_name "${CMAKE_MATCH_1}")
        else()
            continue()
        endif()

        # --enable-decoder=h264 -> h264_decoder
        if(_name MATCHES "^([a-z0-9_]+)=(.+)$")
            set(_group "${CMAKE_MATCH_1}")
            set(_item "${CMAKE_MATCH_2}")
            if(_group MATCHES "^(decoder|encoder|bsf|hwaccel|demuxer|muxer|protocol|filter|indev|outdev|parser)s?$")
                set(_name "${_item}_${_group}")
                if(_group STREQUAL "filters")
                    set(_name "${_item}_filter")
                endif()
            endif()
        endif()

        if(_name STREQUAL "everything")
            if(_value STREQUAL "yes")
                set(FFMPEG_DISABLE_EVERYTHING OFF CACHE BOOL "" FORCE)
            else()
                set(FFMPEG_DISABLE_EVERYTHING ON CACHE BOOL "" FORCE)
            endif()
            continue()
        elseif(_name STREQUAL "gpl")
            set(FFMPEG_ENABLE_GPL ${_value} CACHE BOOL "" FORCE)
            continue()
        elseif(_name STREQUAL "version3")
            set(FFMPEG_ENABLE_VERSION3 ${_value} CACHE BOOL "" FORCE)
            continue()
        elseif(_name STREQUAL "nonfree")
            set(FFMPEG_ENABLE_NONFREE ${_value} CACHE BOOL "" FORCE)
            continue()
        elseif(_name STREQUAL "programs")
            set(FFMPEG_ENABLE_PROGRAMS ${_value} CACHE BOOL "" FORCE)
            continue()
        elseif(_name STREQUAL "doc")
            set(FFMPEG_ENABLE_DOC ${_value} CACHE BOOL "" FORCE)
            continue()
        elseif(_name STREQUAL "x86asm")
            set(FFMPEG_ENABLE_X86ASM ${_value} CACHE BOOL "" FORCE)
            continue()
        elseif(_name STREQUAL "avx512")
            set(FFMPEG_ENABLE_AVX512 ${_value} CACHE BOOL "" FORCE)
            continue()
        elseif(_name STREQUAL "shared")
            set(FFMPEG_ENABLE_SHARED ${_value} CACHE BOOL "" FORCE)
            continue()
        elseif(_name STREQUAL "static")
            set(FFMPEG_ENABLE_STATIC ${_value} CACHE BOOL "" FORCE)
            continue()
        elseif(_name STREQUAL "small")
            set(FFMPEG_ENABLE_SMALL ${_value} CACHE BOOL "" FORCE)
            continue()
        elseif(_name STREQUAL "debug")
            set(FFMPEG_ENABLE_DEBUG ${_value} CACHE BOOL "" FORCE)
            continue()
        endif()

        ffmpeg_option_name("${_name}" _opt)
        if(DEFINED CACHE{${_opt}})
            if(_value STREQUAL "yes")
                set(${_opt} "ON" CACHE STRING "" FORCE)
                ffmpeg_base_set("${_name}" yes)
            else()
                set(${_opt} "OFF" CACHE STRING "" FORCE)
                ffmpeg_base_set("${_name}" no)
            endif()
        endif()
    endforeach()
endfunction()
