# =============================================================================
# Small helpers shared by the version independent engine.
# =============================================================================

function(ffmpeg_status msg)
    message(STATUS "[ffmpeg] ${msg}")
endfunction()

function(ffmpeg_warn msg)
    message(WARNING "[ffmpeg] ${msg}")
endfunction()

# ---------------------------------------------------------------------------
# Tristate configuration state
#
#   base  : what the user asked for  (yes / no / auto)
#   state : the resolved answer      (yes / no)
#
# "auto" means "enable it if something selects it or its deps are satisfied".
# ---------------------------------------------------------------------------
function(ffmpeg_base_set name value)
    string(TOLOWER "${name}" name)
    set_property(GLOBAL PROPERTY "FFMPEG_BASE_${name}" "${value}")
endfunction()

function(ffmpeg_base_get name out)
    string(TOLOWER "${name}" name)
    set(_v "")
    get_property(_v GLOBAL PROPERTY "FFMPEG_BASE_${name}")
    if("${_v}" STREQUAL "")
        set(_v auto)
    endif()
    set(${out} "${_v}" PARENT_SCOPE)
endfunction()

function(ffmpeg_state_set name value)
    string(TOLOWER "${name}" name)
    set_property(GLOBAL PROPERTY "FFMPEG_STATE_${name}" "${value}")
endfunction()

function(ffmpeg_state_get name out)
    string(TOLOWER "${name}" name)
    set(_v "")
    get_property(_v GLOBAL PROPERTY "FFMPEG_STATE_${name}")
    if("${_v}" STREQUAL "")
        set(_v no)
    endif()
    set(${out} "${_v}" PARENT_SCOPE)
endfunction()

function(ffmpeg_enabled name out)
    ffmpeg_state_get("${name}" _v)
    if(_v STREQUAL "yes")
        set(${out} TRUE PARENT_SCOPE)
    else()
        set(${out} FALSE PARENT_SCOPE)
    endif()
endfunction()

function(ffmpeg_enabled_any names out)
    set(_any FALSE)
    foreach(_n IN LISTS names)
        ffmpeg_state_get("${_n}" _v)
        if(_v STREQUAL "yes")
            set(_any TRUE)
            break()
        endif()
    endforeach()
    set(${out} ${_any} PARENT_SCOPE)
endfunction()

function(ffmpeg_enabled_all names out)
    set(_all TRUE)
    foreach(_n IN LISTS names)
        ffmpeg_state_get("${_n}" _v)
        if(NOT _v STREQUAL "yes")
            set(_all FALSE)
            break()
        endif()
    endforeach()
    set(${out} ${_all} PARENT_SCOPE)
endfunction()

# ---------------------------------------------------------------------------
# Makefile helpers
# ---------------------------------------------------------------------------
function(ffmpeg_read_makefile path out)
    if(NOT EXISTS "${path}")
        set(${out} "" PARENT_SCOPE)
        return()
    endif()
    file(READ "${path}" _content)
    string(REPLACE "\r\n" "\n" _content "${_content}")
    # Join backslash line continuations.  In a CMake quoted argument the
    # sequence below is: backslash + newline.
    string(REPLACE "\\\n" " " _content "${_content}")
    set(${out} "${_content}" PARENT_SCOPE)
endfunction()

# Split a makefile into logical lines (continuations already joined).
function(ffmpeg_makefile_lines content out)
    string(REPLACE "\n" ";" _lines "${content}")
    set(${out} "${_lines}" PARENT_SCOPE)
endfunction()

# Parse "VAR[+]:?= value" into variable, condition and value.
#   out_var      base variable name, e.g. OBJS / X86ASM-OBJS
#   out_cond     condition expression, e.g. "$(CONFIG_H264_DECODER)" or
#                "-$(!CONFIG_VULKAN)" or "" for unconditional
#   out_value    right hand side
function(ffmpeg_parse_assignment line out_var out_cond out_value out_ok)
    set(${out_ok} FALSE PARENT_SCOPE)
    string(STRIP "${line}" _line)
    string(LENGTH "${_line}" _line_len)
    if(_line_len EQUAL 0 OR _line MATCHES "^#")
        return()
    endif()

    # Ignore conditional directives and recipes.
    if(_line MATCHES "^(ifeq|ifneq|ifdef|ifndef|else|endif|include|-include|export|unexport)\\b")
        return()
    endif()

    string(FIND "${_line}" "=" _eq)
    if(_eq EQUAL -1)
        return()
    endif()
    string(SUBSTRING "${_line}" 0 ${_eq} _lhs)
    math(EXPR _vstart "${_eq}+1")
    string(SUBSTRING "${_line}" ${_vstart} -1 _value)
    string(STRIP "${_lhs}" _lhs)
    string(STRIP "${_value}" _value)

    # Strip assignment operator decorations.
    if(_lhs MATCHES "\\+$")
        string(REGEX REPLACE "\\+$" "" _lhs "${_lhs}")
    elseif(_lhs MATCHES ":$")
        string(REGEX REPLACE ":$" "" _lhs "${_lhs}")
    elseif(_lhs MATCHES "\\?$")
        string(REGEX REPLACE "\\?$" "" _lhs "${_lhs}")
    endif()
    string(STRIP "${_lhs}" _lhs)
    string(LENGTH "${_lhs}" _lhs_len)
    if(_lhs_len EQUAL 0)
        return()
    endif()

    # Separate "OBJS-$(CONFIG_X)" into "OBJS" + "$(CONFIG_X)", keeping a
    # possible leading '-' (negated condition).
    string(FIND "${_lhs}" "$(" _p)
    if(_p EQUAL -1)
        set(_var "${_lhs}")
        set(_cond "")
    else()
        math(EXPR _pend "${_p}-1")
        string(SUBSTRING "${_lhs}" 0 ${_pend} _var)
        string(SUBSTRING "${_lhs}" ${_p} -1 _rest)
        if(_var MATCHES "-$")
            string(REGEX REPLACE "-$" "" _var "${_var}")
            set(_cond "-${_rest}")
        else()
            set(_cond "${_rest}")
        endif()
    endif()

    # We only care about object lists.
    if(NOT (_var STREQUAL "OBJS" OR _var STREQUAL "STLIBOBJS"
            OR _var STREQUAL "SHLIBOBJS" OR _var MATCHES "-OBJS$"
            OR _var STREQUAL "HEADERS" OR _var MATCHES "-HEADERS$"))
        return()
    endif()

    set(${out_var} "${_var}" PARENT_SCOPE)
    set(${out_cond} "${_cond}" PARENT_SCOPE)
    set(${out_value} "${_value}" PARENT_SCOPE)
    set(${out_ok} TRUE PARENT_SCOPE)
endfunction()

# Evaluate a make condition such as
#   $(CONFIG_H264_DECODER)   $(HAVE_MMX_INLINE)   -$(!CONFIG_VULKAN)
# Variables are resolved through the CMake configuration state, where
# HAVE_/CONFIG_/ARCH_ prefixes are stripped and lowercased.
function(ffmpeg_make_condition cond out)
    if("${cond}" STREQUAL "")
        set(${out} TRUE PARENT_SCOPE)
        return()
    endif()

    set(_expr "${cond}")
    set(_unknown FALSE)
    set(_guard 0)
    while(_expr MATCHES "\\$\\(([^()]*)\\)")
        set(_rawvar "${CMAKE_MATCH_1}")
        set(_var "${_rawvar}")
        math(EXPR _guard "${_guard}+1")
        if(_guard GREATER 32)
            set(_unknown TRUE)
            break()
        endif()
        set(_negate FALSE)
        if(_var MATCHES "^!")
            set(_negate TRUE)
            string(REGEX REPLACE "^!" "" _var "${_var}")
        endif()

        set(_name "${_var}")
        if(_name MATCHES "^CONFIG_(.*)$")
            string(TOLOWER "${CMAKE_MATCH_1}" _name)
        elseif(_name MATCHES "^HAVE_(.*)$")
            string(TOLOWER "${CMAKE_MATCH_1}" _name)
        elseif(_name MATCHES "^ARCH_(.*)$")
            string(TOLOWER "${CMAKE_MATCH_1}" _name)
        else()
            string(TOLOWER "${_name}" _name)
        endif()

        ffmpeg_state_get("${_name}" _st)
        if(_st STREQUAL "yes")
            set(_val "yes")
        else()
            set(_val "no")
        endif()
        if(_negate)
            if(_val STREQUAL "yes")
                set(_val "no")
            else()
                set(_val "yes")
            endif()
        endif()

        string(REPLACE "$(${_rawvar})" "${_val}" _expr "${_expr}")
    endwhile()

    if(_unknown OR _expr MATCHES "\\$\\(")
        set(${out} FALSE PARENT_SCOPE)
        return()
    endif()

    string(STRIP "${_expr}" _expr)
    if(_expr STREQUAL "yes")
        set(${out} TRUE PARENT_SCOPE)
    else()
        set(${out} FALSE PARENT_SCOPE)
    endif()
endfunction()

# Split a string on commas that are not nested inside parentheses.
function(ffmpeg_split_top_commas text out_first out_second out_third)
    set(_first "")
    set(_second "")
    set(_third "")
    set(_depth 0)
    set(_part "")
    string(LENGTH "${text}" _len)
    set(_i 0)
    while(_i LESS _len)
        string(SUBSTRING "${text}" ${_i} 1 _c)
        if(_c STREQUAL "(")
            math(EXPR _depth "${_depth}+1")
            string(APPEND _part "${_c}")
        elseif(_c STREQUAL ")")
            math(EXPR _depth "${_depth}-1")
            string(APPEND _part "${_c}")
        elseif(_c STREQUAL "," AND _depth EQUAL 0)
            string(LENGTH "${_first}" _first_len)
            if(_first_len EQUAL 0)
                set(_first "${_part}")
            elseif(_second STREQUAL "")
                set(_second "${_part}")
            endif()
            set(_part "")
        else()
            string(APPEND _part "${_c}")
        endif()
        math(EXPR _i "${_i}+1")
    endwhile()
    if(_second STREQUAL "")
        set(_second "${_part}")
        set(_third "")
    else()
        set(_third "${_part}")
    endif()
    string(STRIP "${_first}" _first)
    string(STRIP "${_second}" _second)
    string(STRIP "${_third}" _third)
    set(${out_first} "${_first}" PARENT_SCOPE)
    set(${out_second} "${_second}" PARENT_SCOPE)
    set(${out_third} "${_third}" PARENT_SCOPE)
endfunction()

# Expand GNU make $(if cond,then[,else]) expressions.
function(ffmpeg_expand_if_functions text out)
    set(_s "${text}")
    set(_guard 0)
    while(TRUE)
        math(EXPR _guard "${_guard}+1")
        if(_guard GREATER 64)
            break()
        endif()
        string(FIND "${_s}" "$(if " _p)
        if(_p EQUAL -1)
            break()
        endif()

        string(LENGTH "${_s}" _len)
        set(_i ${_p})
        set(_depth 0)
        set(_end -1)
        while(_i LESS _len)
            string(SUBSTRING "${_s}" ${_i} 1 _c)
            if(_c STREQUAL "(")
                math(EXPR _depth "${_depth}+1")
            elseif(_c STREQUAL ")")
                math(EXPR _depth "${_depth}-1")
                if(_depth EQUAL 0)
                    set(_end ${_i})
                    break()
                endif()
            endif()
            math(EXPR _i "${_i}+1")
        endwhile()
        if(_end EQUAL -1)
            break()
        endif()

        math(EXPR _inner_start "${_p}+4")
        math(EXPR _inner_len "${_end}-${_inner_start}")
        string(SUBSTRING "${_s}" ${_inner_start} ${_inner_len} _inner)
        string(STRIP "${_inner}" _inner)
        ffmpeg_split_top_commas("${_inner}" _cond _then _else)

        ffmpeg_make_condition("${_cond}" _ok)
        if(_ok)
            set(_repl "${_then}")
        else()
            set(_repl "${_else}")
        endif()

        string(SUBSTRING "${_s}" 0 ${_p} _pre)
        math(EXPR _post "${_end}+1")
        string(SUBSTRING "${_s}" ${_post} -1 _post_txt)
        set(_s "${_pre}${_repl}${_post_txt}")
    endwhile()
    set(${out} "${_s}" PARENT_SCOPE)
endfunction()

# Expand a make value, dropping (and reporting) unresolved $(...) references.
# Value of a single GNU make variable reference.  Mirrors config.mak: the
# CONFIG_*/HAVE_* variables expand to yes/no, and unknown variables expand to
# the empty string (GNU make semantics), which is what happens for the
# upstream EMMS_OBJS_* and empty COMPAT_OBJS cases.
function(ffmpeg_make_var_value name out)
    if("${name}" MATCHES "^CONFIG_(.+)$")
        ffmpeg_state_get("${CMAKE_MATCH_1}" _st)
        if(_st STREQUAL "yes")
            set(${out} "yes" PARENT_SCOPE)
        else()
            set(${out} "no" PARENT_SCOPE)
        endif()
        return()
    endif()
    if("${name}" MATCHES "^HAVE_(.+)$")
        ffmpeg_state_get("${CMAKE_MATCH_1}" _st)
        if(_st STREQUAL "yes")
            set(${out} "yes" PARENT_SCOPE)
        else()
            set(${out} "no" PARENT_SCOPE)
        endif()
        return()
    endif()
    if("${name}" MATCHES "^ARCH_(.+)$")
        string(TOLOWER "${CMAKE_MATCH_1}" _arch)
        ffmpeg_state_get("${_arch}" _st)
        if(_st STREQUAL "yes")
            set(${out} "yes" PARENT_SCOPE)
        else()
            set(${out} "no" PARENT_SCOPE)
        endif()
        return()
    endif()
    if(name STREQUAL "SRC_PATH")
        set(${out} "${FFMPEG_SOURCE_DIR}" PARENT_SCOPE)
        return()
    endif()
    get_property(_v GLOBAL PROPERTY "FFMPEG_MAKE_${name}")
    set(${out} "${_v}" PARENT_SCOPE)
endfunction()

function(ffmpeg_expand_make_refs text out)
    set(_s "${text}")
    set(_guard 0)
    while(TRUE)
        math(EXPR _guard "${_guard}+1")
        if(_guard GREATER 256)
            break()
        endif()

        # Pattern substitution: $(VAR:%.o=../compat/%.o) or $(VAR:.o=.c)
        string(REGEX MATCH "\\$\\(([A-Za-z0-9_]+):([^=)]*)=([^)]*)\\)"
               _whole "${_s}")
        if(NOT _whole STREQUAL "")
            set(_name "${CMAKE_MATCH_1}")
            set(_pat "${CMAKE_MATCH_2}")
            set(_rep "${CMAKE_MATCH_3}")
            ffmpeg_make_var_value("${_name}" _val)
            separate_arguments(_items UNIX_COMMAND "${_val}")
            set(_new "")
            foreach(_item IN LISTS _items)
                if(_pat STREQUAL "%")
                    string(REPLACE "%" "${_item}" _piece "${_rep}")
                elseif(_pat MATCHES "%")
                    string(REPLACE "%" "(.*)" _regex "${_pat}")
                    if(_item MATCHES "^${_regex}$")
                        string(REPLACE "%" "${CMAKE_MATCH_1}" _piece "${_rep}")
                    else()
                        set(_piece "${_item}")
                    endif()
                else()
                    string(REGEX REPLACE "${_pat}$" "${_rep}" _piece "${_item}")
                endif()
                list(APPEND _new "${_piece}")
            endforeach()
            string(REPLACE ";" " " _new_str "${_new}")
            string(REPLACE "${_whole}" "${_new_str}" _s "${_s}")
            if(_whole STREQUAL "${_new_str}")
                break()
            endif()
            continue()
        endif()

        # Plain reference: $(VAR) or ${VAR}
        set(_whole "")
        if(_s MATCHES "\\$\\(([A-Za-z0-9_]+)\\)")
            set(_whole "${CMAKE_MATCH_0}")
            set(_name "${CMAKE_MATCH_1}")
        elseif(_s MATCHES "\\$\\{([A-Za-z0-9_]+)\\}")
            set(_whole "${CMAKE_MATCH_0}")
            set(_name "${CMAKE_MATCH_1}")
        endif()
        if(_whole STREQUAL "")
            break()
        endif()
        ffmpeg_make_var_value("${_name}" _val)
        string(REPLACE "${_whole}" "${_val}" _s "${_s}")
        if(_whole STREQUAL "${_val}")
            break()
        endif()
    endwhile()
    set(${out} "${_s}" PARENT_SCOPE)
endfunction()

function(ffmpeg_expand_make_value value out)
    ffmpeg_expand_if_functions("${value}" _v)
    ffmpeg_expand_make_refs("${_v}" _v)
    # Drop anything still left (unsupported make functions).  Treating them
    # as empty matches make for the object-list variables FFmpeg uses.
    if(_v MATCHES "\\$\\(")
        string(REGEX REPLACE "\\$\\([^)]*\\)" "" _v "${_v}")
    endif()
    separate_arguments(_v UNIX_COMMAND "${_v}")
    set(${out} "${_v}" PARENT_SCOPE)
endfunction()

# ---------------------------------------------------------------------------
# Generic CRLF-safe list file reader.
# ---------------------------------------------------------------------------
function(ffmpeg_read_lines path out)
    file(STRINGS "${path}" _lines)
    set(${out} "${_lines}" PARENT_SCOPE)
endfunction()
